<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="/images/logo-mercado-liebre.jpg" />

	<title> Mercado Autos Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/bootstrap-grid.min.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/app.css">
</head>

<body>
	<!-- Header -->
	<%- include("./partials/headerLog.ejs") %>
	<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Agregar productos</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<div class="col-12 col-md-8">
				<form class="form" action="/" method="GET">
					<label class="form-label" for="imagen">Imagen</label>
					<input class="form-input" type="text" name="imagen" id="imagen" required>

					<label class="form-label" for="nombre">Nombre del producto</label>
					<input class="form-input" type="text" name="nombre" id="nombre" required>

					<label class="form-label" for="descripcion">Descripcion</label>
					<textarea class="form-input" name="descripcion" id="descripcion" required></textarea>

					<button class="buy-now-button" type="submit">Cargar producto</button>
				</form>
			</div>


	<!-- footer -->
	<%- include("./partials/footer.ejs") %>
	<!-- /footer -->
</body>

</html>