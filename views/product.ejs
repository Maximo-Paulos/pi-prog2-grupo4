<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="./images/logo-mercado-liebre.jpg" />

	<title> Mercado Autos Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/bootstrap-grid.min.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/app.css">
</head>
<body>
	<!-- Header -->
	
	<!-- /Header -->
	<%- include("./partials/header.ejs") %>
	<!-- product detail -->
	<div class="container products-wrapper">
		<div class="d-flex align-items-center" class="edit-boton">
			<h2 class="products-title"><%= producto.nombre %></h2>
			<% if (locals.user && producto.usuario && locals.user.id == producto.usuario.id) { %>
			<p class="buy-now-button">
				<a href="/products/edit/<%= producto.id %>">Editar</a>
			</p>
			<form action="/products/delete/<%= producto.id %>" method="POST">
				<button type="submit" class="buy-now-button">Eliminar</button>
			</form>
			<% } %>
		</div>
		<div class="product-detail">
			<div class="row">
				<article class="col-12 col-lg-8 product-detail-info">
					<img src="/images/products/<%= producto.imagen %>" alt="" class="product-detail-img">
					<p class="product-detail-description"><%= producto.descripcion %></p>
				</article>
				<div class="col-12 col-lg-4">
					<section class="comments">
						<% for (let i = 0; i < producto.comentarios.length; i++) { %>
						<article>
							<img src="/images/users/<%= producto.comentarios[i].usuario.fotoPerfil %>" alt="">
							<div class="data">
								<p class="user">
									<strong> <a href="/users/perfil/<%= producto.comentarios[i].usuario.id %>"><%= producto.comentarios[i].usuario.nombre %>: </a> </strong>
									<%= producto.comentarios[i].texto %>
								</p>
							</div>
						</article>
						<% } %>
					</section>
					<% if (locals.user) { %>
					<form class="form" action="/products/product/<%= producto.id %>/comentario" method="POST">
						<input class="form-input" type="text" name="texto" placeholder="Agregar comentario" required>
						<button type="submit" class="buy-now-button">AGREGAR COMENTARIO</button>
					</form>
					<% } else { %>
					<p><a href="/users/login">Iniciá sesión</a> para dejar tu comentario.</p>
					<% } %>
					<hr>
				</div>
			</div>
		</div>
	</div>
	<!-- /product detail -->

	<!-- footer -->
	<%- include("./partials/footer.ejs") %>
	<!-- /footer -->

</body>	
</html>